# Скопируйте в .env.local (локально) и в Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Публичный ключ: anon (eyJ...) или publishable (sb_publishable_...). НЕ secret/service_role!
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Адрес проекта с тренажёрами (папка play), без слэша в конце
NEXT_PUBLIC_PLAY_ORIGIN=https://YOUR-PLAY.vercel.app

# Название сайта в шапке
NEXT_PUBLIC_SITE_NAME=Материалы для учителей

# Адрес сайта (для QR-кода и ссылки «Поделиться»), без слэша в конце
NEXT_PUBLIC_SITE_URL=https://ib-teachers-hub.vercel.app
